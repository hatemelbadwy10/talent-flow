	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Talent Flow uses the camera so you can take and upload profile, identity, portfolio, and project images.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>We use microphone access to record and send voice messages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
